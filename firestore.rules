rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function active() {
      return hasProfile() && me().ativo == true;
    }
    function isAdmin() {
      return active() && me().role == 'administrador';
    }
    function isManager() {
      return active() && me().role in ['administrador', 'master', 'gestor'];
    }
    function myCollaboratorId() {
      return active() && ('colaboradorId' in me()) ? me().colaboradorId : '';
    }
    function isMyCollaborator(id) {
      return active() && myCollaboratorId() == id;
    }
    function isMyMovement() {
      return active() && resource.data.colaboradorId == myCollaboratorId();
    }
    function isMyReservedResource() {
      return active()
        && ('responsavelColaboradorId' in resource.data)
        && resource.data.responsavelColaboradorId == myCollaboratorId();
    }
    function collaboratorResourceTransition() {
      return isMyReservedResource()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','responsavelColaboradorId','responsavelNome','atualizadoEm','atualizadoPor'
        ])
        && request.resource.data.status in ['Em uso','Aguardando inspeção','Disponível'];
    }

    match /usuarios/{userId} {
      // Todo usuário precisa ler o próprio perfil para entrar. Só Administrador gerencia usuários.
      allow read: if active() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /colaboradores/{id} {
      allow read: if isManager() || isMyCollaborator(id);
      allow create, update: if isManager();
      allow delete: if false;
    }

    match /obras/{id} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if false;
    }

    match /epis/{id} {
      allow read: if isManager();
      allow create, update: if isManager();
      allow delete: if false;
    }

    match /equipamentos/{id} {
      allow read: if isManager() || (active() && resource.data.responsavelColaboradorId == myCollaboratorId());
      allow create: if isManager();
      allow update: if isManager() || collaboratorResourceTransition();
      allow delete: if false;
    }

    match /kits/{id} {
      allow read: if isManager() || (active() && resource.data.responsavelColaboradorId == myCollaboratorId());
      allow create: if isManager();
      allow update: if isManager() || collaboratorResourceTransition();
      allow delete: if false;
    }

    match /estoque_movimentacoes/{id} {
      allow read, create: if isManager();
      allow update, delete: if false;
    }

    match /inspecoes/{id} {
      allow read, create, update: if isManager();
      allow delete: if false;
    }

    match /mobilizacoes/{id} {
      allow read, create, update: if isManager();
      allow delete: if false;
    }

    match /movimentacoes/{id} {
      allow read: if isManager() || isMyMovement();
      allow create: if isManager();
      allow delete: if false;
      allow update: if isManager()
        || (isMyMovement()
          && resource.data.statusAssinatura == 'pendente'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'statusAssinatura','assinaturaBase64','assinadoEm','assinadoPor','assinadoPorNome','estado'
          ])
          && request.resource.data.statusAssinatura == 'assinado')
        || (isMyMovement()
          && resource.data.statusAssinatura == 'assinado'
          && resource.data.estado == 'em_posse'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','devolvidoEm'])
          && request.resource.data.estado == 'devolvido');
    }

    match /auditoria/{id} {
      allow read: if isManager();
      allow create: if active();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
